# Banco de dados
POSTGRES_DB=mydly
POSTGRES_USER=mydly
POSTGRES_PASSWORD=mydly
POSTGRES_PORT=5432

# Segredo dos tokens de login (HS256), com pelo menos 32 caracteres. Vazio: a API gera um a cada
# subida, e é preciso entrar de novo depois de reiniciá-la. Gere um com: openssl rand -base64 48
MYDLY_JWT_SECRET=

# Parser: chave da API da Anthropic para o LLM de fallback (ADR 0013). Vazia, o parser usa só as
# regras locais e pergunta ao usuário o que elas não entendem.
LLM_API_KEY=

# Notificações push pelo Firebase Cloud Messaging (ADR 0016): caminho do JSON da conta de serviço do
# projeto Firebase, no computador que roda o backend. Vazio, nenhum push é enviado.
FCM_SERVICE_ACCOUNT_FILE=

# Open Finance pelo Pluggy, só sandbox (ADR 0015): crie um time em dashboard.pluggy.ai e copie o
# CLIENT_ID e o CLIENT_SECRET. Vazios, o Open Finance fica desligado.
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
