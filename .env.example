# Banco de dados
POSTGRES_DB=mydly
POSTGRES_USER=mydly
POSTGRES_PASSWORD=mydly
POSTGRES_PORT=5432

# Segredo dos tokens de login (HS256), com pelo menos 32 caracteres. Vazio: a API gera um a cada
# subida, e é preciso entrar de novo depois de reiniciá-la. Gere um com: openssl rand -base64 48
MYDLY_JWT_SECRET=

# Parser: deixe vazio para rodar só com regras locais (sem LLM)
LLM_API_KEY=

# Open Finance (sandbox do agregador)
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
